/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CUT&RUN Downstream Peak Analysis Nextflow Config File
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default configuration options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default parameters
params {
    // =========================================================================
    // Experiment & Input / Output Paths (Required in config/experiment.config)
    // =========================================================================

    samplesheet                    = "${launchDir}/config/samplesheet.csv"

    // =========================================================================
    // Step Toggles (Turn individual downstream peak analysis outputs on/off)
    // =========================================================================
    // Step c: Calling peaks (MACS2 and/or HOMER)
    run_macs2_callpeak             = true
    run_homer_findpeaks            = false
    run_merge_replicate_peaks      = true
    run_merge_master_peaks         = true
    run_homer_annotatepeaks        = true
    run_homer_diffpeaks            = false
    run_deeptools_metapeak         = true
    run_homer_findmotifs           = true
    run_meme_streme                = false
    run_summary_plots              = true


    // Step d: bedtools replicate & condition peak merging
    active_peak_caller             = 'macs2'                 // Which peaks feed into Step d ('macs2' or 'homer')
    min_replicate_overlap          = 2                       // Keep peaks present in >= N replicates per condition

    // =========================================================================
    // Tool-Specific Parameters
    // =========================================================================
    // Genome Reference Settings
    genome_name                    = 'ce11'                  // Used by HOMER (e.g., ce11, mm10, hg38, dm6)
    homer_dir                      = "${projectDir}/assets/homer_ce11"
    genome_fasta                   = "${projectDir}/assets/homer_ce11/data/genomes/ce11" // FASTA file or directory of chr*.fa
    chrom_sizes                    = "${projectDir}/assets/homer_ce11/data/genomes/ce11/chrom.sizes"


    // Step c: IgG Negative Control Settings
    use_igg_control                = false                   // Pass matched control_id (-c / -i) to MACS2 and HOMER
    macs2_scale_to                 = null                    // Optional MACS2 scaling with control: 'small', 'large', or null

    // Step c: MACS2 parameters (dispatched per sample via meta.peak_mode from samplesheet.csv)
    macs2_gsize                    = 'ce'                    // hs, mm, ce, dm, or numeric size
    macs2_format                   = 'BAMPE'                 // BAMPE (paired-end), BAM, BED
    macs2_nomodel                  = false                   // Set true (+ macs2_extsize) if using single-end BAM on broad marks
    macs2_extsize                  = 147                     // Fragment extension size when macs2_nomodel = true
    macs2_narrow_pvalue            = 1e-5                    // Strict p-value cutoff for narrow marks in CUT&RUN (set null to use macs2_narrow_qvalue)
    macs2_narrow_qvalue            = 0.01                    // Fallback q-value when macs2_narrow_pvalue is null
    macs2_broad_qvalue             = 0.01                    // Explicit -q seed cutoff for broad marks (avoids MACS2 default 0.05)
    macs2_broad_cutoff             = 0.05                    // --broad-cutoff for broad marks (e.g. H3K27me3)

    // Step c: HOMER findPeaks parameters (dispatched per sample via meta.peak_mode from samplesheet.csv)
    homer_narrow_style             = 'factor'                // -style for narrow marks (sharp TF / active promoter)
    homer_narrow_fold              = 2                       // -F fold enrichment for narrow marks
    homer_narrow_local_fold        = 3                       // -L local fold enrichment for narrow marks (balanced between 2 and default 4)
    homer_broad_style              = 'histone'               // -style for broad marks (repressive / histone domains)
    homer_broad_fold               = 3                       // -F fold enrichment for broad marks
    homer_broad_local_fold         = 1.5                     // -L local fold filter for broad marks
    homer_broad_min_dist           = 1000                    // -minDist for merging adjacent broad regions

    // Step e: HOMER annotatePeaks
    annotatepeaks_size             = 'given'                 // -size given

    // Step f: HOMER getDifferentialPeaksReplicates contrasts
    // List of maps: [ [ id: 'cond2_vs_cond1', treatment: 'cond2', background: 'cond1', target: 'H3K4me3' ] ]
    diff_contrasts                 = []

    // Step g: deepTools computeMatrix & plotHeatmap
    metapeak_upstream              = 2000                    // -b BP_UPSTREAM
    metapeak_downstream            = 2000                    // -a BP_DOWNSTREAM
    metapeak_reference_point       = 'center'                // --referencePoint center
    heatmap_colormap               = 'inferno'               // --colorMap inferno
    heatmap_interpolation          = 'nearest'               // --interpolationMethod nearest

    // Step h: Motif discovery (HOMER & MEME STREME)
    homer_motif_size               = '100'                   // Numeric (e.g. 100) or 'given'
    meme_slop_left                 = 50                      // -l 50
    meme_slop_right                = 49                      // -r 49 (produces 100bp window centered on peak)
    meme_streme_nmotifs            = 20                      // --nmotifs 20

    // Step i: Summary & Volcano/MA Plot Parameters
    volcano_fdr_threshold          = 0.05
    volcano_log2fc_threshold       = 1.0
    volcano_top_n_labels           = 12

    // =========================================================================
    // Boilerplate Options
    // =========================================================================
    publish_dir_mode               = 'copy'
    email                          = null
    help                           = false
    trace_report_suffix            = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// Load base resource configuration and DSL2 module-specific options
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// =========================================================================
// *************************************************************************
// Load experiment-specific configuration
// *************************************************************************
includeConfig "${launchDir}/config/experiment.config"
// =========================================================================

params {
    // =========================================================================
    // Input Globs (Dropbox inputs & local peak fallbacks)
    // =========================================================================
    input_bam                      = "${params.input_dir}/08_deeptools/bam_index/*.bam"
    input_tagdirs                  = "${params.input_dir}/07_homer/tag_dir/*"
    input_bigwig                   = "${params.input_dir}/${params.active_bigwig_dir}/*.bw"
    input_sample_peaks             = "${params.outdir}/09_peaks/${params.active_peak_caller}/*_${params.active_peak_caller}_merge_ready_peaks.bed"
    input_replicated_peaks         = "${params.outdir}/10_merged_peaks/replicates/*_replicated_peaks.bed"
    input_peaks_bed                = "${params.outdir}/10_merged_peaks/master/*_master_peaks.bed"
    input_annotated_peaks          = "${params.outdir}/11_peak_quantification/*_annotated_peaks.txt"
    input_diff_peaks               = "${params.outdir}/12_differential_peaks/*_differential_peaks.txt"
}

// Enable Docker by default and mount projectDir, input_dir, and HOMER genome data
docker.enabled    = true
docker.runOptions = "-u \$(id -u):\$(id -g) -v '${projectDir}:${projectDir}' -v '${params.input_dir}:${params.input_dir}' -v '${params.homer_dir}/data:/opt/conda/share/homer/data' -v '${params.homer_dir}/config.txt:/opt/conda/share/homer/config.txt' -v '${params.homer_dir}/data:/usr/local/share/homer-4.9.1-5/data' -v '${params.homer_dir}/config.txt:/usr/local/share/homer-4.9.1-5/config.txt'"

// Profiles for different execution environments
profiles {
    debug {
        dumpHashes                                   = true
        process.beforeScript                         = 'echo $HOSTNAME'
        cleanup                                      = false
        nextflow.enable.configProcessNamesValidation = true
    }

    docker {
        docker.enabled       = true
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        apptainer.enabled    = false
        docker.runOptions    = "-u \$(id -u):\$(id -g) -v '${projectDir}:${projectDir}' -v '${params.input_dir}:${params.input_dir}' -v '${params.homer_dir}/data:/opt/conda/share/homer/data' -v '${params.homer_dir}/config.txt:/opt/conda/share/homer/config.txt' -v '${params.homer_dir}/data:/usr/local/share/homer-4.9.1-5/data' -v '${params.homer_dir}/config.txt:/usr/local/share/homer-4.9.1-5/config.txt'"
    }
    arm64 {
        process.arch            = 'arm64'
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions = "-u \$(id -u):\$(id -g) -v '${projectDir}:${projectDir}' -v '${params.input_dir}:${params.input_dir}' -v '${params.homer_dir}/data:/opt/conda/share/homer/data' -v '${params.homer_dir}/config.txt:/opt/conda/share/homer/config.txt' -v '${params.homer_dir}/data:/usr/local/share/homer-4.9.1-5/data' -v '${params.homer_dir}/config.txt:/usr/local/share/homer-4.9.1-5/config.txt' --platform=linux/amd64"
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }

}


// Strict bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit
    "pipefail"    //   with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'cutandrun'
    contributors    = [
        [
            name: 'DanHUMassMed',
            affiliation: 'UMass Chan Medical School',
            email: 'daniel.higgins@umassmed.edu',
            github: '',
            contribution: ['author', 'maintainer'],
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/DanHUMassMed/Cut_And_Run_Analysis'
    description     = 'Nextflow CUT&RUN downstream peak analysis pipeline'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0'
    doi             = ''
}
