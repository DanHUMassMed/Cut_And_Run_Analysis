/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MACS2_CALLPEAK' {
        ext.args = {
            [
                "-g ${params.macs2_gsize}",
                "-f ${params.macs2_format}",
                "-q ${params.macs2_qvalue}",
                params.macs2_broad ? "--broad --broad-cutoff ${params.macs2_broad_cutoff}" : ''
            ].findAll { it }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/09_peaks/macs2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HOMER_FINDPEAKS' {
        ext.args = { "-style ${params.homer_peak_style}" }
        publishDir = [
            path: { "${params.outdir}/09_peaks/homer" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BEDTOOLS_MERGE_REPLICATES' {
        publishDir = [
            path: { "${params.outdir}/10_merged_peaks/replicates" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BEDTOOLS_MERGE_MASTER' {
        publishDir = [
            path: { "${params.outdir}/10_merged_peaks/master" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HOMER_ANNOTATEPEAKS' {
        ext.args = { "-size ${params.annotatepeaks_size}" }
        publishDir = [
            path: { "${params.outdir}/11_peak_quantification" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HOMER_GETDIFFERENTIALPEAKS' {
        ext.args = '-all'
        publishDir = [
            path: { "${params.outdir}/12_differential_peaks" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DEEPTOOLS_METAPEAK' {
        ext.args = {
            [
                "-a ${params.metapeak_downstream}",
                "-b ${params.metapeak_upstream}",
                "--referencePoint ${params.metapeak_reference_point}"
            ].join(' ')
        }
        ext.args2 = {
            [
                "--colorMap ${params.heatmap_colormap}",
                "--interpolationMethod ${params.heatmap_interpolation}"
            ].join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/13_metapeak_plots" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HOMER_FINDMOTIFSGENOME' {
        ext.args = { "-size ${params.homer_motif_size}" }
        publishDir = [
            path: { "${params.outdir}/14_motifs/homer" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MEME_STREME' {
        ext.args = { "--nmotifs ${params.meme_streme_nmotifs} --dna" }
        publishDir = [
            path: { "${params.outdir}/14_motifs/meme_streme" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PLOT_PEAK_COUNTS' {
        publishDir = [
            path: { "${params.outdir}/15_summary_plots/01_peak_counts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PLOT_ANNOTATED_SUMMARY' {
        publishDir = [
            [
                path: { "${params.outdir}/15_summary_plots/02_genomic_features" },
                mode: params.publish_dir_mode,
                pattern: "*_genomic_features.*"
            ],
            [
                path: { "${params.outdir}/15_summary_plots/03_correlation_and_pca" },
                mode: params.publish_dir_mode,
                pattern: "*_correlation_*"
            ],
            [
                path: { "${params.outdir}/15_summary_plots/04_signal_distributions" },
                mode: params.publish_dir_mode,
                pattern: "*_signal_*"
            ]
        ]
    }

    withName: 'PLOT_DIFFERENTIAL_VOLCANO_MA' {
        ext.args = {
            [
                "--fdr-threshold ${params.volcano_fdr_threshold}",
                "--log2fc-threshold ${params.volcano_log2fc_threshold}",
                "--top-n-labels ${params.volcano_top_n_labels}"
            ].join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/15_summary_plots/05_differential_plots" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
