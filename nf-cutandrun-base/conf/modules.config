/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'FASTQC_RAW' {
        module = 'fastqc/0.11.9'
        publishDir = [
            path: { "${params.outdir}/02_fastqc/original" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC_RAW' {
        module = { params.multiqc_module ?: '' }
        publishDir = [
            path: { "${params.outdir}/02_multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'TRIMMOMATIC' {
        ext.args = { params.trimmomatic_args ?: 'SLIDINGWINDOW:4:10 TRAILING:3 MINLEN:10' }
        publishDir = [
            path: { "${params.outdir}/01_trim" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTQC_TRIMMED' {
        module = 'fastqc/0.11.9'
        publishDir = [
            path: { "${params.outdir}/02_fastqc/trimmed" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC_TRIMMED' {
        module = { params.multiqc_module ?: '' }
        publishDir = [
            path: { "${params.outdir}/02_multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BOWTIE2_ALIGN' {
        module = 'bowtie2/2.5.0:samtools/1.16.1'
        ext.args = { params.bowtie2_args ?: '--very-sensitive -N 0 -X 500' }
        publishDir = [
            path: { "${params.outdir}/03_align" },
            mode: params.publish_dir_mode,
            enabled: params.publish_align_sam,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PICARD_DEDUP' {
        module = 'samtools/1.16.1'
        ext.args = {
            [
                "VALIDATION_STRINGENCY=${params.picard_validation_stringency}",
                "SORT_ORDER=coordinate"
            ].join(' ')
        }
        ext.args2 = {
            [
                "VALIDATION_STRINGENCY=${params.picard_validation_stringency}",
                "REMOVE_DUPLICATES=${params.picard_remove_duplicates}"
            ].join(' ')
        }
        publishDir = [
            [
                path: { "${params.outdir}/04_dedup" },
                mode: params.publish_dir_mode,
                pattern: "*_dup.txt"
            ],
            [
                path: { "${params.outdir}/04_dedup" },
                mode: params.publish_dir_mode,
                enabled: params.publish_dedup_bam,
                pattern: "*_PicardDedup.bam"
            ]
        ]
    }

    withName: 'SAMTOOLS_MAPQ_FILTER' {
        module = 'samtools/1.16.1'
        ext.args = { "-q ${params.mapq_threshold}" }
        publishDir = [
            path: { "${params.outdir}/05_mapq_filter" },
            mode: params.publish_dir_mode,
            enabled: params.publish_mapq_sam,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_BAM_BIGWIG' {
        module = 'samtools/1.16.1:deeptools/3.5.6'
        ext.args = { "--normalizeUsing ${params.bamcoverage_norm}" }
        publishDir = [
            path: { "${params.outdir}/06_index_bam" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HOMER_UCSC' {
        module = 'homer_env/4.11:samtools/1.16.1'
        beforeScript = { params.homer_bin_dir ? "export PATH=${params.homer_bin_dir}:\$PATH" : '' }
        publishDir = [
            path: { "${params.outdir}/07_ucsc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'UCSC_BEDGRAPHTOBIGWIG' {
        module = 'ucsc_utilities/20240312'
        publishDir = [
            path: { "${params.outdir}/08_bigwig" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}

